---
import site from '../content/site.json';

interface Props {
  locale: 'fr' | 'ja';
}

const { locale } = Astro.props;
---

<footer class="footer">
  <div class="wrap footer-inner">
    <img src="/images/mvv-white.png" width="464" height="319" alt={site.name} lang="fr" loading="lazy" />
    <div class="footer-copy">{site.footer[locale]}</div>
    <nav>
      {site.navigation.map((item) => item.available
        ? <a href={item.href}>{item[locale]}</a>
        : <span role="link" aria-disabled="true">{item[locale]}</span>)}
    </nav>
  </div>
</footer>
