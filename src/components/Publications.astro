---
import { getCollection } from 'astro:content';
import site from '../content/site.json';
import ui from '../content/publication-ui.json';
import '../styles/publications.css';

interface Props {
  locale: 'fr' | 'ja';
}

const { locale } = Astro.props;
const copy = ui[locale];
const pageSize = 7;
const heading = site.navigation.find(item => item.href === '#publications')![locale];
const publications = (await getCollection('publications'))
  .filter(({ data }) => locale === 'ja' || data.pdf_fr)
  .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
const initialCount = Math.min(pageSize, publications.length);
const icons = {
  article: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4',
  revue: 'M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2zM8 7h6M8 11h6',
  rapport: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  compilation: 'M12 3l9 5-9 5-9-5zM3 13l9 5 9-5M3 17l9 5 9-5',
  session: 'M4 5h16v11H9l-5 4z',
};
---

<section class="wrap home-section publications" id="publications" aria-labelledby="publications-title" data-page-size={pageSize}>
  <div class="eyebrow">{heading}</div>
  <h2 id="publications-title">{copy.title}</h2>
  <div class="publication-chips" role="group" aria-label={heading} hidden>
    {Object.entries(copy.filters).map(([type, label]) => (
      <button type="button" data-type={type} aria-pressed={type === 'all'}>{label}</button>
    ))}
  </div>
  <div class="publication-meta-row">
    <span role="status" data-count data-single={copy.count} data-plural={copy.countPlural}>
      {(initialCount === 1 ? copy.count : copy.countPlural).replace('{count}', String(initialCount))}
    </span>
    <button class="publication-years" type="button" aria-label={copy.clearYears} hidden>
      {copy.years} <span aria-hidden="true">✕</span>
    </button>
  </div>
  <div class="publication-grid" id="publication-grid">
    {publications.map(({ data, id }, index) => {
      const japanese = locale === 'ja' && Boolean(data.pdf_ja);
      const pdf = japanese ? data.pdf_ja : data.pdf_fr;
      const pages = japanese ? data.pages_ja : data.pages_fr;
      const frenchOnly = locale === 'ja' && Boolean(data.pdf_fr) && !data.pdf_ja;
      const languages = [data.pdf_fr && copy.languageFr, data.pdf_ja && copy.languageJa];
      const meta = [data.year, copy.types[data.type], pages && copy.pages.replace('{count}', String(pages)), pdf && copy.pdf, ...languages];
      const publication = data[locale];

      return (
        <article class="publication-card" id={id} data-year={data.year} data-type={data.type} hidden={index >= pageSize}>
          <div class:list={['publication-cover', data.type, { 'has-image': data.cover }]}>
            {data.cover && <img src={data.cover} alt="" loading="lazy" decoding="async" />}
            <span class="publication-category">{copy.types[data.type]}</span>
            <div class="publication-cover-year" aria-hidden="true">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[data.type]} />
              </svg>
              <span>{data.year}</span>
            </div>
          </div>
          <div class="publication-body">
            <div class="publication-card-meta">{meta.filter(Boolean).join(' · ')}</div>
            <h3>{publication.title}</h3>
            <p>{publication.description}</p>
            {frenchOnly && <div class="publication-note">{copy.frenchOnly} · <span lang="fr">{ui.fr.frenchOnly}</span></div>}
            {pdf
              ? <a class="publication-read" href={pdf} hreflang={japanese ? 'ja' : 'fr'}>{frenchOnly ? copy.readFrench : copy.read}</a>
              : <span class="publication-note">{copy.unavailable}</span>}
          </div>
        </article>
      );
    })}
  </div>
  <div class="publication-more">
    <button class="btn outline" type="button" aria-controls="publication-grid" aria-expanded="false" data-more={copy.more} data-less={copy.less} hidden>{copy.more}</button>
  </div>
  <p class="publication-fine">{copy.fine}</p>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#publications');

  if (section) {
    const chips = section.querySelector<HTMLElement>('.publication-chips')!;
    const filters = [...chips.querySelectorAll<HTMLButtonElement>('[data-type]')];
    const years = section.querySelector<HTMLButtonElement>('.publication-years')!;
    const count = section.querySelector<HTMLElement>('[data-count]')!;
    const more = section.querySelector<HTMLButtonElement>('.publication-more button')!;
    const cards = [...section.querySelectorAll<HTMLElement>('.publication-card')];
    const pageSize = Number(section.dataset.pageSize);

    const params = new URLSearchParams(location.search);
    let type = filters.find(filter => filter.dataset.type === params.get('type'))?.dataset.type ?? 'all';
    let restrictYears = params.get('years') === '2026,2027';
    let expanded = false;

    const render = () => {
      const matches = cards.filter(card =>
        (type === 'all' || card.dataset.type === type) &&
        (!restrictYears || card.dataset.year === '2026' || card.dataset.year === '2027')
      );
      const visible = new Set(expanded ? matches : matches.slice(0, pageSize));
      for (const card of cards) card.hidden = !visible.has(card);
      for (const filter of filters) filter.setAttribute('aria-pressed', String(filter.dataset.type === type));
      years.hidden = !restrictYears;
      more.hidden = matches.length <= pageSize;
      more.setAttribute('aria-expanded', String(expanded));
      more.textContent = (expanded ? more.dataset.less : more.dataset.more) ?? '';
      const template = visible.size === 1 ? count.dataset.single : count.dataset.plural;
      count.textContent = template?.replace('{count}', String(visible.size)) ?? '';
    };

    const syncFilters = () => {
      const url = new URL(location.href);
      if (type === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', type);
      if (!restrictYears) url.searchParams.delete('years');
      history.replaceState(null, '', url);
      render();
    };

    for (const filter of filters) {
      filter.addEventListener('click', () => {
        type = filter.dataset.type ?? 'all';
        expanded = false;
        syncFilters();
      });
    }
    years.addEventListener('click', () => {
      restrictYears = false;
      expanded = false;
      syncFilters();
      filters.find(filter => filter.dataset.type === type)?.focus();
    });
    more.addEventListener('click', () => {
      expanded = !expanded;
      render();
    });
    chips.hidden = false;
    render();
  }
</script>
